# Local API and Dev Server Configuration
APP_ORIGIN="http://127.0.0.1:3000"
API_PORT=3001
DATABASE_PATH="data/precisign.sqlite"
VITE_DATA_MODE=api
BACKUP_DIRECTORY=backups

# PostHog Product Analytics (public browser configuration)
VITE_POSTHOG_KEY=phc_your_project_token
VITE_POSTHOG_HOST=https://your-posthog-host

# Hosting and Reverse Proxy (e.g., Render backend + Cloudflare frontend)
# Set STANDALONE_API=true on Render when backend only serves /api and static frontend is hosted on Cloudflare.
STANDALONE_API=false
# Set TRUST_PROXY=1 when behind a single reverse proxy (Render / Cloudflare) to ensure accurate client IP rate limiting.
# TRUST_PROXY=1

# Optional remote database (Turso / LibSQL). Use server-side secrets for tokens.
# PRECISIGN_DATABASE=turso
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Outbound Email Delivery (Resend)
# Options: 'mock' (local dev/test, logs only), 'disabled' (no delivery), 'sandbox' (routes to safe test recipient), 'live' (production)
PRECISIGN_EMAIL_MODE=mock
# RESEND_API_KEY=re_your_resend_api_key_here
# PRECISIGN_EMAIL_SENDER="PreciSign Notifications <notifications@yourcompany.com>"
# PRECISIGN_TEST_RECIPIENT="delivered@resend.dev"
# PRECISIGN_EMAIL_APP_URL="https://precisign.yourcompany.com"


# Optional private R2 storage for submitted request attachments
PRECISIGN_R2_ENDPOINT=
PRECISIGN_R2_BUCKET=
PRECISIGN_R2_ACCESS_KEY_ID=
PRECISIGN_R2_SECRET_ACCESS_KEY=

# Optional Sentry Error Monitoring (Free Tier & Privacy Conscious)
# Performance tracing and session replays are disabled to conserve free-tier quota.
# Employee identities, session cookies, auth tokens, form bodies, and signatures are scrubbed.
#
# Backend (Node.js / Express): Server-side only; keep secret and never expose in frontend builds.
# SENTRY_DSN=https://your-backend-key@o0.ingest.sentry.io/0000000
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=precisign-api@1.0.0
#
# Frontend (Vite / React): Public browser DSN embedded in client bundle during Vite build.
# VITE_SENTRY_DSN=https://your-frontend-key@o0.ingest.sentry.io/0000000
# VITE_SENTRY_ENVIRONMENT=production
# VITE_SENTRY_RELEASE=precisign-web@1.0.0
