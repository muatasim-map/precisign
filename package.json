{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/build.mjs",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "package": "tsx scripts/package-release.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "start": "node server.js",
    "backup": "tsx backend/src/backup.ts",
    "restore": "tsx backend/src/backup.ts restore",
    "test:startup": "tsx --test backend/src/startup.test.ts",
    "test:server:turso": "node --import ./backend/src/requireTursoTestEnv.mjs --import tsx --test --test-concurrency=1 backend/src/accountAdmin.test.ts backend/src/reads.test.ts backend/src/requests.test.ts backend/src/tursoRemaining.test.ts",
    "test:backup": "tsx --test backend/src/backup.test.ts",
    "dev:server": "tsx backend/src/index.ts",
    "provision:user": "tsx backend/src/provision-user.ts",
    "provision:pilot": "tsx backend/src/bootstrap-pilot.ts",
    "seed:pilot-workflows": "tsx backend/src/seed-pilot-workflows.ts",
    "import:workflow": "tsx backend/src/import-workflow.ts",
    "test:server": "tsx --test backend/src/server.test.ts backend/src/bootstrap-pilot.test.ts backend/src/accountAdmin.test.ts backend/src/pilotAccess.test.ts backend/src/reads.test.ts backend/src/requests.test.ts backend/src/requests.boundaries.test.ts backend/src/drafts.test.ts backend/src/profile.test.ts backend/src/workflows.test.ts backend/src/multiCompanySubmission.test.ts",
    "test:document": "tsx --test frontend/src/components/document/AdminWorkRequestDocument.test.ts",
    "test:api": "tsx --test frontend/src/services/apiRepository.test.ts frontend/src/services/apiSession.test.ts frontend/src/services/draftCoordinator.test.ts",
    "build:vercel": "node scripts/build-vercel.mjs",
    "dev:showcase": "vite --mode showcase --port=3195 --host=127.0.0.1",
    "build:showcase": "vite build --mode showcase",
    "test:showcase": "tsx --test frontend/src/data/showcaseData.test.ts",
    "verify:showcase:build": "node scripts/verify-showcase-build.mjs",
    "test:showcase:browser": "node scripts/verify-showcase.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@google/genai": "^2.4.0",
    "@libsql/client": "^0.18.0",
    "@opentelemetry/api-logs": "^0.200.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.200.0",
    "@opentelemetry/resources": "^2.12.1",
    "@opentelemetry/sdk-logs": "^0.200.0",
    "@sentry/node": "11.15.0",
    "@sentry/react": "11.15.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "driver.js": "1.10.2",
    "express": "^4.21.2",
    "html2canvas-pro": "2.6.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdf-lib": "1.17",
    "playwright-core": "1.65.0",
    "posthog-js": "^1.453.2",
    "react": "^19.0.1",
    "react-doctor": "^0.9.22",
    "react-dom": "^19.0.1",
    "resend": "^6.38.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
